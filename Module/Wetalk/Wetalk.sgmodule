#!name=WeTalk 自动签到
#!desc=Surge 专用版。抓取、定时签到、账号管理分离。首次使用需打开 WeTalk 触发 queryBalanceAndBonus 请求完成抓取。
#!system=ios

[General]
force-http-engine-hosts = %APPEND% api.wetalkapp.com:443

[Script]
WeTalk 获取账号参数 = type=http-request, pattern=^https:\/\/api\.wetalkapp\.com\/app\/queryBalanceAndBonus, script-path=WeTalk_Capture.js, requires-body=false, timeout=30
WeTalk 定时签到 = type=cron, cronexp="20 8,20 * * *", script-path=WeTalk_Task.js, timeout=300
WeTalk 账号管理 = type=generic, script-path=WeTalk_Manage.js, argument=action=list, timeout=30

[MITM]
hostname = %APPEND% api.wetalkapp.com
