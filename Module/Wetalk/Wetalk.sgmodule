#!name=WeTalk 自动化签到+视频奖励
#!desc=WeTalk 抓取账号参数后，定时执行签到与视频奖励任务。需启用 MitM 并安装证书。
#!author=TG@ZenMoFiShi, converted for Surge

[Script]
WeTalk 参数抓取 = type=http-request, pattern=^https:\/\/api\.wetalkapp\.com\/app\/queryBalanceAndBonus, script-path=https://github.com/JuemingDC/Surge/raw/main/JavaScript/Wetalk/Wetalk_capture.js, timeout=10
WeTalk 签到任务 = type=cron, cronexp="20 8,20 * * *", script-path=https://github.com/JuemingDC/Surge/raw/main/JavaScript/Wetalk/Wetalk_task.js, timeout=120

[MITM]
hostname = %APPEND% api.wetalkapp.com
