#!name=WeTalk 自动签到
#!desc=WeTalk 签到与视频奖励。首次使用需打开 WeTalk 触发 queryBalanceAndBonus 请求完成参数抓取；之后按 cron 定时运行。
#!system=ios

[General]
force-http-engine-hosts = %APPEND% api.wetalkapp.com

[Script]
WeTalk 获取签到参数 = type=http-request, pattern=^https:\/\/api\.wetalkapp\.com\/app\/queryBalanceAndBonus, script-path=https://raw.githubusercontent.com/JuemingDC/Surge/refs/heads/main/JavaScript/Wetalk/Wetalk_capture.js, requires-body=false, timeout=60
WeTalk 签到 = type=cron, cronexp="20 8,20 * * *", script-path=https://raw.githubusercontent.com/JuemingDC/Surge/refs/heads/main/JavaScript/Wetalk/Wetalk_task.js, timeout=300

[MITM]
hostname = %APPEND% api.wetalkapp.com
