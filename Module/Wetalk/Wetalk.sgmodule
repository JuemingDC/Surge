#!name=WeTalk 自动化签到+视频奖励
#!desc=WeTalk 抓取账号参数后，定时执行签到与视频奖励任务；支持多账号、指定运行、查看账号、删除账号和清空账号。需启用 MitM 并安装证书。
#!author=TG@ZenMoFiShi, converted for Surge
#!category=签到
#!arguments=RUN_ACCOUNTS=&DELETE_ACCOUNTS=&DELETE_ALL=false

[Script]
WeTalk 参数抓取 = type=http-request, pattern=^https:\/\/api\.wetalkapp\.com\/app\/queryBalanceAndBonus(?:\?.*)?$, script-path=https://raw.githubusercontent.com/JuemingDC/Surge/main/JavaScript/Wetalk/Wetalk_capture.js, timeout=10, script-update-interval=0, argument=SHOW_SENSITIVE=false

WeTalk 签到任务 = type=cron, cronexp="5 */6 * * *", script-path=https://raw.githubusercontent.com/JuemingDC/Surge/main/JavaScript/Wetalk/Wetalk_task.js, timeout=120, script-update-interval=0, argument=RUN_ACCOUNTS=%RUN_ACCOUNTS%

WeTalk 账号列表 = type=generic, script-path=https://raw.githubusercontent.com/JuemingDC/Surge/main/JavaScript/Wetalk/Wetalk_account_manager.js, timeout=30, script-update-interval=0, argument=ACTION=list

WeTalk 删除账号 = type=generic, script-path=https://raw.githubusercontent.com/JuemingDC/Surge/main/JavaScript/Wetalk/Wetalk_account_manager.js, timeout=30, script-update-interval=0, argument=ACTION=delete&DELETE_ACCOUNTS=%DELETE_ACCOUNTS%&DELETE_ALL=%DELETE_ALL%

[MITM]
hostname = %APPEND% api.wetalkapp.com
