#!name=PluginHub2Surge by Script Hub
#!desc=将可莉插件中心 PluginHub 的 Loon 插件导入链接重定向为 Script Hub 的 Surge 模块转换链接。插件中心：https://hub.kelee.one
#!author=iab0x00 / modified for Surge
#!category=工具
#!requirement=CORE_VERSION>=20

[Header Rewrite]
http-request ^https:\/\/hub\.kelee\.one\/list\.json header-del if-none-match

[Body Rewrite]
http-response ^https:\/\/hub\.kelee\.one\/list\.json loon:\/\/import\?plugin=(https:\/\/kelee\.one\/Tool\/Loon\/Lpx\/(.+?)\.lpx) https://script.hub/file/_start_/https%3A%2F%2Fkelee.one%2FTool%2FLoon%2FLpx%2F$2.lpx?type=surge-module

[MITM]
hostname = %APPEND% hub.kelee.one
