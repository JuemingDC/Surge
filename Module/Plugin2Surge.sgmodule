#!name=Kelee Hub → Surge via ScriptHub
#!desc=将 https://hub.kelee.one 的 Loon 插件导入链接改为 Surge 安装，并交给 Script Hub 转换
#!author=Your Majesty
#!category=工具

[General]
force-http-engine-hosts = %APPEND% hub.kelee.one, script.hub, *.script.hub

[Script]
Kelee Hub: 改写导入链接 = type=http-response, pattern=^https?:\/\/hub\.kelee\.one\/, requires-body=1, max-size=-1, script-path=https://raw.githubusercontent.com/JuemingDC/Surge/refs/heads/main/JavaScript/script.js, timeout=300

Script Hub: 重写转换 = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module), script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/Rewrite-Parser.js, timeout=300

[MITM]
hostname = %APPEND% hub.kelee.one, script.hub, *.script.hub
