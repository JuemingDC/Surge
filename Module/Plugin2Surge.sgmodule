#!name=PluginHub2Surge
#!desc=将可莉插件中心 Loon 插件安装按钮改为：经 Script Hub 转换后跳转 Surge 安装模块
#!author=iab0x00 / modified for Surge
#!category=工具
#!requirement=CORE_VERSION>=20

[Header Rewrite]
^https:\/\/hub\.kelee\.one\/list\.json header-del if-none-match

[Body Rewrite]
^https:\/\/hub\.kelee\.one\/list\.json loon:\/\/import\?plugin=https:\/\/kelee\.one\/Tool\/Loon\/Lpx\/(.+?)\.lpx surge:///install-config?url=https%3A%2F%2Fscript.hub%2Ffile%2F_start_%2Fhttps%253A%252F%252Fkelee.one%252FTool%252FLoon%252FLpx%252F$1.lpx%3Ftype%3Dsurge-module

[MITM]
hostname = %APPEND% hub.kelee.one